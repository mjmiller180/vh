{
	"manifest_version": 3,
	"key": "",
	"name": "VineTools",
	"description": "Improve the Amazon Vine experience.",
	"version": "4.5",
	"permissions": [
		"contextMenus",
		"storage",
		"tabs",
		"identity"
	],
	"content_security_policy": {
		"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://discord.com https://discordapp.com https://sheets.googleapis.com; img-src 'self' data: https://*.media-amazon.com;"
	},
	"icons": {
		"32": "resource/image/icon-32.png",
		"48": "resource/image/icon-48.png",
		"128": "resource/image/icon-128.png"
	},
	"action": {
		"default_popup": "popup/homepage.html",
		"default_title": "VineTools",
		"default_icon": "resource/image/icon-48.png"
	},
	"options_ui": {
		"page": "popup/homepage.html"
	},
	"host_permissions": [
		"*://*.amazon.ca/*",
		"*://*.amazon.it/*",
		"*://*.amazon.es/*",
		"*://*.amazon.de/*",
		"*://*.amazon.fr/*",
		"*://*.amazon.co.uk/*",
		"*://*.amazon.co.jp/*",
		"*://*.amazon.com/*",
		"*://*.amazon.com.au/*",
		"*://*.amazon.com.br/*",
		"*://*.amazon.com.mx/*",
		"*://*.amazon.sg/*",
		"https://discord.com/api/webhooks/*",
		"https://discordapp.com/api/webhooks/*"
	],
	"web_accessible_resources": [
		{
			"resources": [
				"resource/image/*",
				"resource/css/*",
				"scripts/*"
			],
			"matches": [
				"*://*.amazon.ca/*",
				"*://*.amazon.it/*",
				"*://*.amazon.es/*",
				"*://*.amazon.de/*",
				"*://*.amazon.fr/*",
				"*://*.amazon.co.uk/*",
				"*://*.amazon.co.jp/*",
				"*://*.amazon.com/*",
				"*://*.amazon.com.au/*",
				"*://*.amazon.com.br/*",
				"*://*.amazon.com.mx/*",
				"*://*.amazon.sg/*"
			]
		}
	],
	"background": {
		"type": "module",
		"service_worker": "scripts/vh_service_worker_di.js"
	},
	"content_scripts": [
		{
			"css": [
				"resource/css/grid.css",
				"resource/css/icon.css",
				"resource/css/icon_chrome.css",
				"resource/css/main.css",
				"resource/css/modal.css",
				"resource/css/notification.css",
				"resource/css/toolbar.css",
				"resource/css/vinehelper.css"
			],
			"js": [
				"scripts/bootloaderLoader.js",
				"scripts/category-toggle-module.js"
			],
			"matches": [
				"*://*.amazon.ca/vine/*",
				"*://*.amazon.ca/*/vine/*",
				"*://*.amazon.it/vine/*",
				"*://*.amazon.de/vine/*",
				"*://*.amazon.de/*/vine/*",
				"*://*.amazon.es/vine/*",
				"*://*.amazon.fr/vine/*",
				"*://*.amazon.co.uk/vine/*",
				"*://*.amazon.co.jp/vine/*",
				"*://*.amazon.co.jp/*/vine/*",
				"*://*.amazon.com/vine/*",
				"*://*.amazon.com.au/vine/*",
				"*://*.amazon.com.br/vine/*",
				"*://*.amazon.com.mx/vine/*",
				"*://*.amazon.sg/vine/*"
			],
			"run_at": "document_end"
		},
		{
			"js": [
				"scripts/preboot_inj.js",
				"scripts/prebootLoader.js"
			],
			"matches": [
				"*://*.amazon.ca/vine/*",
				"*://*.amazon.ca/*/vine/*",
				"*://*.amazon.it/vine/*",
				"*://*.amazon.de/vine/*",
				"*://*.amazon.de/*/vine/*",
				"*://*.amazon.es/vine/*",
				"*://*.amazon.fr/vine/*",
				"*://*.amazon.co.uk/vine/*",
				"*://*.amazon.co.jp/vine/*",
				"*://*.amazon.co.jp/*/vine/*",
				"*://*.amazon.com/vine/*",
				"*://*.amazon.com.au/vine/*",
				"*://*.amazon.com.br/vine/*",
				"*://*.amazon.com.mx/vine/*",
				"*://*.amazon.sg/vine/*"
			],
			"run_at": "document_start"
		},
		{
			"js": [
				"scripts/skipPrimeAd.js"
			],
			"matches": [
				"*://*.amazon.ca/checkout/p/*",
				"*://*.amazon.com/checkout/p/*",
				"*://*.amazon.de/checkout/p/*",
				"*://*.amazon.fr/checkout/p/*",
				"*://*.amazon.co.uk/checkout/p/*",
				"*://*.amazon.co.jp/checkout/p/*",
				"*://*.amazon.com.au/checkout/p/*",
				"*://*.amazon.com.br/checkout/p/*",
				"*://*.amazon.com.mx/checkout/p/*",
				"*://*.amazon.sg/checkout/p/*",
				"*://*.amazon.it/checkout/p/*",
				"*://*.amazon.es/checkout/p/*",
				"*://*.amazon.ca/gp/buy/thankyou/*",
				"*://*.amazon.com/gp/buy/thankyou/*",
				"*://*.amazon.de/gp/buy/thankyou/*",
				"*://*.amazon.fr/gp/buy/thankyou/*",
				"*://*.amazon.co.uk/gp/buy/thankyou/*",
				"*://*.amazon.co.jp/gp/buy/thankyou/*",
				"*://*.amazon.com.au/gp/buy/thankyou/*",
				"*://*.amazon.com.br/gp/buy/thankyou/*",
				"*://*.amazon.com.mx/gp/buy/thankyou/*",
				"*://*.amazon.sg/gp/buy/thankyou/*",
				"*://*.amazon.it/gp/buy/thankyou/*",
				"*://*.amazon.es/gp/buy/thankyou/*"
			],
			"run_at": "document_end"
		}
	],
	"oauth2": {
		"client_id": "REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com",
		"scopes": [
			"https://www.googleapis.com/auth/spreadsheets"
		]
	}
}
